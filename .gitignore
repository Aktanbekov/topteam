# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# --- Secrets / local config ---
.env
.env.local
config.local.json

# --- Dashcam footage & captured media ---
# Video files are large and may contain people who did not consent.
# Keep them out of git; store them in a local folder instead.
videos/
footage/
*.mp4
*.mov
*.avi
*.mkv

# The demo clips are the exception, and a deliberate one: they are rendered by
# tools/make_test_clip.py, about 500 KB each, contain no people at all, and are
# what makes ./run.sh --demo work on a fresh clone. The recorded scene labels
# beside them are what makes it work with no model server.
!demo/*.mp4

# --- Generated output (frames, screenshots, reports) ---
output/
.pytest_cache/
frames/
screenshots/
reports/
*.log

# --- Editors / OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
